  "bugs": {
    "url": "https://github.com/adamcrews/deploy-to-vercel-action/issues"
  },
  "homepage": "https://github.com/adamcrews/deploy-to-vercel-action",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.1",
    "action-input-parser": "^1.2.38",
    "dotenv": "^16.6.1",
    "vercel": "^59.1.4"
  },
  "devDependencies": {
    "@betahuhn/config": "^1.2.0",
